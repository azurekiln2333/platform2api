# Copy to .env and fill in every required value before `docker compose up -d`.
#
# Generate random printable ASCII secrets, for example:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"

# --- panel -------------------------------------------------------------------
# Required. At least 12 characters. This is the console login key.
PLATFORM_ADMIN_KEY=
# Published host port and bind address for the console.
PLATFORM_PORT=9000
PLATFORM_BIND_HOST=127.0.0.1
# Set when the console is served through a reverse proxy over HTTPS.
PLATFORM_PUBLIC_URL=
# Optional SSO bootstrap for a fresh panel; saved console settings win afterwards.
PLATFORM_SSO_ENABLED=
PLATFORM_KEY_LOGIN_ENABLED=
PLATFORM_OIDC_ISSUER=
PLATFORM_OIDC_CLIENT_ID=
PLATFORM_OIDC_CLIENT_SECRET=
PLATFORM_OIDC_SCOPES=
PLATFORM_OIDC_PROVIDER_NAME=
PLATFORM_OIDC_ALLOWED_SUBJECTS=
PLATFORM_OIDC_ALLOWED_EMAILS=
# Local image name built by docker-compose.build.yaml.
PLATFORM_IMAGE=platform2api:local

# --- shared --------------------------------------------------------------
# Bind address for the three published service ports. These serve model traffic
# and stay independent of the panel (R7).
SERVICE_BIND_HOST=127.0.0.1
COMPOSE_PROJECT_NAME=platform2api
TZ=UTC

# --- CNB ---------------------------------------------------------------------
CNB_IMAGE=docker.cnb.cool/azurekiln/cnb2api-panel:latest
CNB_PORT=9002
# Required: the CNB service validates both keys at startup (>= 12 chars, distinct).
CNB_PANEL_ADMIN_KEY=
CNB_GATEWAY_KEY=
CNB_PUBLIC_URL=

# --- CodeBuddy ---------------------------------------------------------------
CODEBUDDY_IMAGE=ghcr.io/azurekiln2333/codebuddy2api:latest
CODEBUDDY_PORT=8787
# SSO is the upstream Compose default and needs the four OIDC values below.
CODEBUDDY2API_SSO_ENABLED=true
CODEBUDDY_PUBLIC_ORIGIN=
CODEBUDDY_OIDC_ISSUER=
CODEBUDDY_OIDC_CLIENT_ID=
CODEBUDDY_OIDC_CLIENT_SECRET=
CODEBUDDY_OIDC_REFRESH=false
ALLOW_INSECURE_LOCALHOST=false

# --- ZCode -------------------------------------------------------------------
ZCODE_IMAGE=ghcr.io/azurekiln2333/zcode2api:latest
ZCODE_PORT=12283
# Optional gateway master key created from the console instead.
ZCODE_GATEWAY_KEY=
# Empty keeps the current keyless local panel; set it for anything beyond loopback.
ZCODE_PANEL_KEY=
ZCODE_UPSTREAM_ORIGIN=https://zcode.z.ai
ZCODE_MODEL=GLM-5.3-Flash

# --- panel -> service management tokens --------------------------------------
# One value per service, shared with that service's PLATFORM_TOKEN, and only
# effective once the service-side patch is deployed. Empty disables the bearer
# branch, so the service behaves exactly as before.
CNB_PLATFORM_TOKEN=
CODEBUDDY_PLATFORM_TOKEN=
ZCODE_PLATFORM_TOKEN=
