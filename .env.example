# Copy to .env and set the panel key. Nothing else needs a value.

# Required, at least 12 characters. Logs into all four consoles; the panel also
# uses it to manage the three services.
PANEL_ADMIN_KEY=

# Only for a console served on its own domain: the origin browsers use.
PLATFORM_PUBLIC_URL=
CNB_PUBLIC_URL=
CODEBUDDY_PUBLIC_URL=
ZCODE_PUBLIC_URL=

# Host ports. Change any of them freely; the containers keep their own ports.
PLATFORM_PORT=9000
CNB_PORT=9002
CODEBUDDY_PORT=8787
ZCODE_PORT=12283
